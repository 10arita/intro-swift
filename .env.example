# App build configuration. Copy this file to .env and fill in the values before building.
# Use the same HTTPS origin as server PUBLIC_BASE_URL. Do not add a trailing slash.
APP_SERVER_URL=
# Set to true after enabling iCloud/CloudKit and registering the container in Xcode.
APP_CLOUDKIT_ENABLED=false
# Public release information. HTTPS URLs must point to published pages.
APP_OPERATOR_NAME=
# Optional public email. Leave blank when using the support page's Google Form.
APP_SUPPORT_EMAIL=
# Published Google Sites privacy-policy page, not its editor URL.
APP_PRIVACY_POLICY_URL=
APP_TERMS_URL=
# Published Google Sites support page containing the contact form link.
APP_SUPPORT_URL=
# Optional direct link to the Google Form's respondent page, not its editor URL.
APP_SUPPORT_FORM_URL=
# Enable only after confirming the MusicKit monetization design and configuring the real product.
APP_MONETIZATION_ENABLED=false
APP_AD_REMOVAL_PRODUCT_ID=
