<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.oucc.intol.chorus-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/arito/github/intro-swift/scripts/sync_chorus_database.py</string>
    <string>--watch</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/arito/github/intro-swift</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/arito/github/intro-swift/.private/chorus/sync.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/arito/github/intro-swift/.private/chorus/sync.stderr.log</string>
</dict>
</plist>
