PORT=3000
PUBLIC_BASE_URL=https://quiz.example.com
DATA_DIR=./data
# サビ相違の報告が届く Discord Webhook URL（サーバーだけに設定）
DISCORD_CHORUS_WEBHOOK_URL=
# 意見・問い合わせ専用の新しい Discord Webhook URL（サーバーだけに設定）
DISCORD_FEEDBACK_WEBHOOK_URL=
# Optional private SQLite source; otherwise DATA_DIR/chorus/catalog.sqlite3 is the sync replica.
CHORUS_DB_PATH=
# Server administration only. At least 32 random characters; never include in the iOS bundle.
CHORUS_SYNC_TOKEN=
